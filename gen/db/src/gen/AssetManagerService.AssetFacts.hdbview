VIEW AssetManagerService_AssetFacts AS SELECT
  a_0.asset_id,
  a_0.asset_tag,
  a_0.serial_number,
  a_0.model,
  assetCategory_2.name AS category,
  a_0.status,
  a_0.location,
  current_holder_3.full_name AS owner,
  department_4.name AS department,
  vendor_5.name AS vendor,
  a_0.vendor_vendor_id AS vendor_id,
  a_0.purchase_date,
  a_0.purchase_cost,
  1 AS assetCount,
  100.0 / (SELECT
      count(*)
    FROM asset_lifecycle_db_Asset AS Asset_1) AS assetPercent
FROM ((((asset_lifecycle_db_Asset AS a_0 LEFT JOIN asset_lifecycle_db_AssetCategory AS assetCategory_2 ON a_0.assetCategory_asset_category_id = assetCategory_2.asset_category_id) LEFT JOIN asset_lifecycle_db_Employee AS current_holder_3 ON a_0.current_holder_employee_id = current_holder_3.employee_id) LEFT JOIN asset_lifecycle_db_Department AS department_4 ON current_holder_3.department_dept_id = department_4.dept_id) LEFT JOIN asset_lifecycle_db_Vendor AS vendor_5 ON a_0.vendor_vendor_id = vendor_5.vendor_id)