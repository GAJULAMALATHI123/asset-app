COLUMN TABLE AssetAdminService_Assets_drafts (
  createdAt TIMESTAMP NULL,
  createdBy NVARCHAR(255) NULL,
  modifiedAt TIMESTAMP NULL,
  modifiedBy NVARCHAR(255) NULL,
  asset_id NVARCHAR(36) NOT NULL,
  asset_tag NVARCHAR(20) NULL,
  serial_number NVARCHAR(50) NULL,
  assetCategory_asset_category_id NVARCHAR(36) NULL,
  vendor_vendor_id NVARCHAR(36) NULL,
  model NVARCHAR(100) NULL,
  location NVARCHAR(100) NULL,
  purchase_date DATE NULL,
  purchase_cost DECIMAL(10, 2) NULL,
  warranty_expiry DATE NULL,
  first_distribution_date DATE NULL,
  status NVARCHAR(5000) NULL DEFAULT 'AVAILABLE',
  current_holder_employee_id NVARCHAR(36) NULL,
  retirement_reason NVARCHAR(255) NULL,
  retirement_date DATE NULL,
  IsActiveEntity BOOLEAN,
  HasActiveEntity BOOLEAN,
  HasDraftEntity BOOLEAN,
  DraftAdministrativeData_DraftUUID NVARCHAR(36) NOT NULL,
  PRIMARY KEY(asset_id)
)