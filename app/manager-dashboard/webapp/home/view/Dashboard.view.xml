<mvc:View
  controllerName="managerdashboard.home.controller.Dashboard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">
  <Page showHeader="false" enableScrolling="true" class="managerDashboardPage">
    <content>
      <VBox class="dashboardContent" width="100%">
        <HBox class="dashboardTopBar" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
          <VBox>
            <Title text="Manager Dashboard" level="H1" class="dashboardTitle"/>
            <Text text="Asset overview, lifecycle insights and maintenance activity" class="dashboardSubtitle"/>
          </VBox>
          <HBox alignItems="Center" wrap="Wrap" class="dashboardActions">
            <Button text="Refresh" icon="sap-icon://refresh" press=".onRefresh" type="Transparent"/>
            <Button text="Asset Register" icon="sap-icon://database" press=".onOpenAssets" type="Emphasized"/>
          </HBox>
        </HBox>

        <HBox class="kpiRow" wrap="Wrap" width="100%">
          <VBox class="kpiCard" width="23%">
            <HBox justifyContent="SpaceBetween" alignItems="Center">
              <Text text="Total Assets" class="kpiLabel"/>
              <core:Icon src="sap-icon://laptop" class="kpiIcon"/>
            </HBox>
            <ObjectNumber number="{dash>/kpis/total}" emphasized="true" class="kpiNumber"/>
            <Text text="Registered in inventory" class="kpiHint"/>
          </VBox>
          <VBox class="kpiCard" width="23%">
            <HBox justifyContent="SpaceBetween" alignItems="Center">
              <Text text="Available" class="kpiLabel"/>
              <core:Icon src="sap-icon://accept" class="kpiIcon"/>
            </HBox>
            <ObjectNumber number="{dash>/kpis/available}" state="Success" emphasized="true" class="kpiNumber"/>
            <Text text="Ready to be assigned" class="kpiHint"/>
          </VBox>
          <VBox class="kpiCard" width="23%">
            <HBox justifyContent="SpaceBetween" alignItems="Center">
              <Text text="Assigned" class="kpiLabel"/>
              <core:Icon src="sap-icon://employee" class="kpiIcon"/>
            </HBox>
            <ObjectNumber number="{dash>/kpis/assigned}" state="Information" emphasized="true" class="kpiNumber"/>
            <Text text="Currently in use" class="kpiHint"/>
          </VBox>
          <VBox class="kpiCard" width="23%">
            <HBox justifyContent="SpaceBetween" alignItems="Center">
              <Text text="Under Maintenance" class="kpiLabel"/>
              <core:Icon src="sap-icon://wrench" class="kpiIcon"/>
            </HBox>
            <ObjectNumber number="{dash>/kpis/maintenance}" state="Warning" emphasized="true" class="kpiNumber"/>
            <Text text="Assets being serviced" class="kpiHint"/>
          </VBox>
        </HBox>

        <HBox class="insightRow" wrap="Wrap" width="100%">
          <VBox class="dashboardPanel" width="49%">
            <Title text="Assets by Lifecycle Status" level="H3"/>
            <Text text="Distribution across the asset lifecycle" class="panelSubtitle"/>
            <List items="{dash>/statusRows}" showSeparators="Inner" noDataText="No asset data available">
              <CustomListItem>
                <VBox class="chartRow">
                  <HBox justifyContent="SpaceBetween" alignItems="Center">
                    <Text text="{dash>label}" class="chartLabel"/>
                    <ObjectNumber number="{dash>count}" emphasized="true"/>
                  </HBox>
                  <ProgressIndicator percentValue="{dash>percent}" displayValue="" state="{dash>state}" height="0.55rem"/>
                </VBox>
              </CustomListItem>
            </List>
          </VBox>
          <VBox class="dashboardPanel" width="49%">
            <Title text="Assets by Department" level="H3"/>
            <Text text="Where inventory is allocated" class="panelSubtitle"/>
            <List items="{dash>/departmentRows}" showSeparators="Inner" noDataText="No department data available">
              <CustomListItem>
                <VBox class="chartRow">
                  <HBox justifyContent="SpaceBetween" alignItems="Center">
                    <Text text="{dash>label}" class="chartLabel"/>
                    <ObjectNumber number="{dash>count}"/>
                  </HBox>
                  <ProgressIndicator percentValue="{dash>percent}" displayValue="" state="Information" height="0.55rem"/>
                </VBox>
              </CustomListItem>
            </List>
          </VBox>
        </HBox>

        <HBox class="insightRow" wrap="Wrap" width="100%">
          <VBox class="dashboardPanel" width="49%">
            <Title text="Assets by Location" level="H3"/>
            <Text text="Inventory across work locations" class="panelSubtitle"/>
            <List items="{dash>/locationRows}" showSeparators="Inner" noDataText="No location data available">
              <CustomListItem>
                <VBox class="chartRow">
                  <HBox justifyContent="SpaceBetween" alignItems="Center">
                    <Text text="{dash>label}" class="chartLabel"/>
                    <ObjectNumber number="{dash>count}"/>
                  </HBox>
                  <ProgressIndicator percentValue="{dash>percent}" displayValue="" state="Success" height="0.55rem"/>
                </VBox>
              </CustomListItem>
            </List>
          </VBox>
          <VBox class="dashboardPanel" width="49%">
            <Title text="Maintenance Tracking" level="H3"/>
            <Text text="Current maintenance workload" class="panelSubtitle"/>
            <HBox class="maintenanceSummary" wrap="Wrap">
              <VBox class="maintenanceMetric">
                <ObjectNumber number="{dash>/maintenance/open}" state="Warning" emphasized="true"/>
                <Text text="Open"/>
              </VBox>
              <VBox class="maintenanceMetric">
                <ObjectNumber number="{dash>/maintenance/inProgress}" state="Information" emphasized="true"/>
                <Text text="In Progress"/>
              </VBox>
              <VBox class="maintenanceMetric">
                <ObjectNumber number="{dash>/maintenance/completed}" state="Success" emphasized="true"/>
                <Text text="Completed"/>
              </VBox>
            </HBox>
            <Button text="View Maintenance Records" icon="sap-icon://wrench" press=".onOpenMaintenance" class="panelAction" type="Transparent"/>
            <Button text="Operational Attention" icon="sap-icon://alert" press=".onOpenAttention" class="panelAction" type="Transparent"/>
          </VBox>
        </HBox>

        <HBox class="bottomRow" wrap="Wrap" width="100%">
          <VBox class="dashboardPanel" width="49%">
            <Title text="Assets by Category" level="H3"/>
            <List items="{dash>/categoryRows}" showSeparators="Inner" noDataText="No category data available">
              <CustomListItem>
                <HBox class="simpleDataRow" justifyContent="SpaceBetween" alignItems="Center">
                  <Text text="{dash>label}"/>
                  <ObjectNumber number="{dash>count}"/>
                </HBox>
              </CustomListItem>
            </List>
          </VBox>
          <VBox class="dashboardPanel" width="49%">
            <Title text="Asset Requests" level="H3"/>
            <Text text="Requests waiting for review" class="panelSubtitle"/>
            <ObjectNumber number="{dash>/requests/pending}" unit="pending requests" state="Warning" emphasized="true" class="requestNumber"/>
            <Button text="View Asset Requests" icon="sap-icon://request" press=".onOpenRequests" class="panelAction" type="Transparent"/>
          </VBox>
        </HBox>
        <Text text="{dash>/lastUpdated}" class="lastUpdated"/>
      </VBox>
    </content>
  </Page>
</mvc:View>
